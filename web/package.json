{
  "name": "menura-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "generate:theme": "tsx scripts/generate-theme.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --project unit",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test-storybook": "vitest run --project storybook",
    "test-e2e": "playwright test"
  },
  "dependencies": {
    "@material/web": "2.5.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@material/material-color-utilities": "0.3.0",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "storybook": "10.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
